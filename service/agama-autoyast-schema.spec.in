%define yast_schemadir /usr/share/YaST2/schema

# disable debuginfo packages
%global debug_package %{nil}

Name:           agama-autoyast-schema
Version:        @VERSION@
Release:        0

BuildRoot:      %{_tmppath}/%{name}-%{version}-build
Source0:        agama-autoyast-schema-%{version}.tar.xz

License:        GPL-2.0-or-later
Url:            https://github.com/agama-project/agama

Provides:       yast2-schema = %{version}
Conflicts:      yast2-schema
Obsoletes:      yast2-schema < %{version}

# Dependencies needed to build the package
BuildRequires:  libxml2-tools
BuildRequires:  trang

Summary:	AutoYaST Schema
%description
AutoYaST RelaxNG schema for autoinstallation profiles.

%prep
%setup -n agama-autoyast-schema-%{version}

%build
make

%check
make check

%install
make install DESTDIR=%{buildroot}

%files
%defattr(-,root,root)
%dir %{yast_schemadir}/autoyast/rnc
%{yast_schemadir}/autoyast/rnc/profile.rnc
%{yast_schemadir}/autoyast/rnc/includes.rnc
%dir %{yast_schemadir}/autoyast/rng
%{yast_schemadir}/autoyast/rng/*.rng

%changelog
