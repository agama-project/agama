{
  "$schema": "https://unpkg.com/knip@latest/jsonschema.json",
  "entry": [
    "scripts/**/*.js",
    "share/po/**/*.js"
  ],
  "project": ["src/**/*.{ts,tsx,js,jsx}"],
  "ignore": [
    "src/po/po.*.js"
  ],
  "ignoreDependencies": [
    "typescript-eslint",
    "eslint-plugin-n",
    "eslint-plugin-promise",
    "eslint-plugin-react"
  ],
  "ignoreExportsUsedInFile": true,
  "webpack": {
    "config": ["webpack.config.js"]
  }
}
