{
  "$schema": "https://unpkg.com/knip@latest/jsonschema.json",
  "entry": [
    "src/index.tsx",
    "scripts/**/*.js",
    "share/po/**/*.js"
  ],
  "project": ["src/**/*.{ts,tsx,js,jsx}"],
  "ignore": [
    "src/po/po.*.js",
    "svgo.config.js"
  ],
  "ignoreDependencies": [
    "typescript-eslint"
  ],
  "webpack": {
    "config": ["webpack.config.js"]
  },
  "ignoreExportsUsedInFile": true
}
