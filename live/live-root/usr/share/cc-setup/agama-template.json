{
  "product": {
    "id": "SLES"
  },
  "questions": {
    "answers": [
      {
        "class": "storage.luks_activation",
        "answer": "skip"
      },
      {
        "class": "storage.activate_multipath",
        "answer": "yes"
      }
    ]
  },
  "root": {
    "hashedPassword": true,
    "password": "[to be set]"
  },
  "user": {
    "fullName": "System Administrator",
    "userName": "sysadmin",
    "hashedPassword": true,
    "password": "[to be set]"
  },
  "software": {
    "patterns": { "add": ["fips", "selinux"] },
    "packages": [
      "certification-sles-eal4",
      "chrony",
      "audit",
      "aide"
    ]
  },
  "storage": {
    "drives": [
      {
        "search": "*",
        "partitions": [
          {
            "search": "*",
            "delete": true
          },
          {
            "alias": "pv",
            "id": "lvm",
            "size": { "min": "8 GiB" },
            "encryption": { "luks2": { "password": "[to be set]" } }
          }
        ]
      }
    ],
    "volumeGroups": [
      {
        "name": "system",
        "physicalVolumes": ["pv"],
        "logicalVolumes": [
          {
            "name": "root",
            "size": { "min": "5 GiB", "max": "20 GiB" },
            "filesystem": { "path": "/", "mountOptions": ["acl"] }
          },
          {
            "name": "var",
            "size": { "min": "1 GiB", "max": "3 GiB" },
            "filesystem": { "path": "/var", "type": "btrfs", "mountOptions": ["acl"] }
          },
          {
            "name": "varlogaudit",
            "size": { "min": "256 MiB", "max": "512 MiB" },
            "filesystem": {
              "path": "/var/log/audit",
              "type": "btrfs",
              "mountOptions": ["acl", "nodev", "noexec", "nosuid"]
            }
          },
          {
            "name": "home",
            "size": { "min": "512 MiB", "max": "1 GiB" },
            "filesystem": { "path": "/home", "type": "btrfs", "mountOptions": ["acl", "nodev"] }
          },
          {
            "name": "swap",
            "size": { "min": "1 GiB", "max": "2 GiB" },
            "filesystem": { "path": "swap" }
          }
        ]
      }
    ]
  },
  "scripts": {
    "post": [
    ]
  }
}
