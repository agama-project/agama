{
  "product": {
    "id": "SLES"
  },
  "questions": {
    "answers": [
      {
        "class": "software.package_error.provide_error",
        "answer": "Continue anyway"
      },
      {
        "class": "storage.luks_activation",
        "answer": "skip"
      },
      {
        "class": "luksActivation",
        "answer": "skip"
      }
    ]
  },
  "root": {
    "hashedPassword": true,
    "password": "[to be set]"
  },
  "user": {
    "fullName": "System Administrator",
    "userName": "sysadmin",
    "hashedPassword": true,
    "password": "[to be set]"
  },
  "bootloader": {
    "timeout": 3
  },
  "software": {
    "patterns": [
      "base",
      "fips"
    ],
    "packages": [
      "certification-sles-eal4",
      "chrony",
      "audit",
      "aide",
      "cryptsetup",
      "lvm2"
    ]
  },
  "storage": {
    "drives": [
      {
        "alias": "disk1",
        "partitions": [{ "search": "*", "delete": true }]
      }
    ],
    "volumeGroups": [
      {
        "name": "system",
        "physicalVolumes": [
          {
            "generate": {
              "targetDevices": ["disk1"],
              "encryption": { "luks2": { "password": "[to be set]" } }
            }
          }
        ],
        "logicalVolumes": [
          {
            "name": "root",
            "size": { "min": "2 GiB" },
            "filesystem": { "path": "/", "mountOptions": ["acl"] }
          },
          {
            "name": "var",
            "size": { "min": "1 GiB" },
            "filesystem": { "path": "/var", "type": "btrfs", "mountOptions": ["acl"] }
          },
          {
            "name": "varlogaudit",
            "size": { "min": "256 MiB", "max": "1 GiB" },
            "filesystem": {
              "path": "/var/log/audit",
              "type": "btrfs",
              "mountOptions": ["acl", "nodev", "noexec", "nosuid"]
            }
          },
          {
            "name": "home",
            "size": { "min": "512 MiB", "max": "2 GiB" },
            "filesystem": { "path": "/home", "type": "btrfs", "mountOptions": ["acl", "nodev"] }
          },
          {
            "name": "swap",
            "size": { "min": "1 GiB", "max": "2 GiB" },
            "filesystem": { "path": "swap" }
          }
        ]
      }
    ]
  },
  "scripts": {
    "post": [
    ]
  }
}
