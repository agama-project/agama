{
  "title": "Move a port to another bond",
  "description": "A port left out of one controller and listed by another one is moved with its settings.",
  "steps": [
    {
      "profile": "1-bond.json",
      "description": "Bond with eth0 and eth1 nested (MTU 9000)",
      "expect": {
        "connections": {
          "bond0": {
            "controller": null,
            "method4": "auto"
          },
          "eth0": {
            "controller": "bond0",
            "mtu": 9000
          },
          "eth1": {
            "controller": "bond0",
            "mtu": 9000
          }
        }
      }
    },
    {
      "profile": "2-move-eth1-to-bond1.json",
      "description": "bond0 without eth1, new bond1 with portConnections: [eth1]",
      "expect": {
        "connections": {
          "eth0": {
            "controller": "bond0"
          },
          "eth1": {
            "controller": "bond1",
            "mtu": 9000
          },
          "bond1": {
            "controller": null
          }
        }
      }
    }
  ]
}
