{
  "title": "Drop a nested port",
  "description": "A port left out of the list of its controller, and not given anywhere else, is deleted.",
  "steps": [
    {
      "profile": "1-bond.json",
      "description": "Bond with eth0 and eth1 nested (MTU 9000)",
      "expect": {
        "connections": {
          "bond0": {
            "controller": null,
            "method4": "auto"
          },
          "eth0": {
            "controller": "bond0",
            "mtu": 9000
          },
          "eth1": {
            "controller": "bond0",
            "mtu": 9000
          }
        }
      }
    },
    {
      "profile": "2-drop-eth1.json",
      "description": "Same bond without eth1",
      "expect": {
        "connections": {
          "eth0": {
            "controller": "bond0",
            "mtu": 9000
          },
          "eth1": {
            "removed": true
          }
        }
      }
    }
  ]
}
