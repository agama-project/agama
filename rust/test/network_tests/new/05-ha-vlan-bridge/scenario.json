{
  "title": "HA with a VLAN bridge: bond0 -> br0, bond0.100 (VLAN) -> br100",
  "description": "Same tree as old/05-ha-vlan-bridge. The VLAN is nested as a port of br100 and refers to its parent by name.",
  "steps": [
    {
      "profile": "1-ha-vlan-bridge.json",
      "description": "The whole setup, nested",
      "expect": {
        "connections": {
          "eth0": {
            "controller": "bond0"
          },
          "eth1": {
            "controller": "bond0"
          },
          "bond0": {
            "controller": "br0"
          },
          "bond0.100": {
            "controller": "br100"
          },
          "br0": {
            "controller": null,
            "addresses": [
              "192.168.1.100/24"
            ]
          },
          "br100": {
            "controller": null,
            "addresses": [
              "10.100.0.10/24"
            ]
          }
        }
      }
    }
  ]
}
