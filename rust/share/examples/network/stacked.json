{
  "network": {
    "connections": [
      {
        "id": "br0",
        "interface": "br0",
        "method4": "manual",
        "addresses": ["192.168.1.100/24"],
        "bridge": {
          "stp": true,
          "portConnections": [
            {
              "id": "bond0",
              "interface": "bond0",
              "port": { "priority": 32, "pathCost": 100 },
              "bond": {
                "mode": "802.3ad",
                "options": "miimon=100 lacp_rate=fast",
                "portConnections": [{ "interface": "eth0", "mtu": 9000 }, "eth1"]
              }
            }
          ]
        }
      },
      {
        "id": "br0.100",
        "interface": "br0.100",
        "method4": "manual",
        "addresses": ["10.100.0.10/24"],
        "vlan": { "id": 100, "parent": "br0" }
      }
    ]
  }
}
